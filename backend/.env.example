# Database configuration
# For PostgreSQL: postgresql://username:password@localhost:5432/agrinex_db
# Defaults to local SQLite if not specified
DATABASE_URL=sqlite:///./agrinex.db

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Model configuration (Optional: OpenRouter / OpenAI / Gemini compatible)
AI_PROVIDER=default
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_BASE=https://api.openai.com/v1

# Secret keys
SECRET_KEY=agrinex-super-secret-key-change-in-production
